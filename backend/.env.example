# ── VeinConnect AI — Backend Environment Template ──────────────────────────

# ── General Server Settings
APP_ENV=development     # development, staging, production
DEBUG=true              # set false in production
SECRET_KEY=generate-a-long-random-string-here-for-security
ALLOWED_HOSTS=localhost,127.0.0.1,api.veinconnect.ai

# ── Database Configurations
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis Configurations
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# ── Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Model Configuration Paths (Weights/Cache)
AI_MODELS_DIR=/app/app/ai/models
AI_CACHE_EXPIRY_MINUTES=60

# ── Third Party Gateways (Optional / Production)
# WhatsApp Gateway Configuration
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id

# SMS Gateway Integration (e.g., Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_SENDER_NUMBER=+1234567890

# UPI / Payment Gateway (for wallets validation)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
